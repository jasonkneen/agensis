{
  "name": "@agensis/ui",
  "version": "0.1.0",
  "description": "Agensis UI: shadcn-derived React components with the default/classic/paper/neo theme families.",
  "license": "MIT",
  "author": "Jason Kneen",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "src",
    "styles",
    "README.md",
    "THEMING.md",
    "LICENSE",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./components/*": {
      "source": "./src/components/ui/*.tsx",
      "types": "./dist/components/ui/*.d.ts",
      "default": "./dist/components/ui/*.js"
    },
    "./theme": {
      "source": "./src/theme/index.ts",
      "types": "./dist/theme/index.d.ts",
      "default": "./dist/theme/index.js"
    },
    "./theme/*": {
      "source": "./src/theme/*.ts",
      "types": "./dist/theme/*.d.ts",
      "default": "./dist/theme/*.js"
    },
    "./types": {
      "source": "./src/types.ts",
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./lib/*": {
      "source": "./src/lib/*.ts",
      "types": "./dist/lib/*.d.ts",
      "default": "./dist/lib/*.js"
    },
    "./tailwind.css": "./styles/tailwind.css",
    "./tokens.css": "./styles/tokens.css",
    "./skin.css": "./styles/skin.css",
    "./components.css": "./styles/components.css",
    "./fonts.css": "./styles/fonts.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19",
    "tailwindcss": ">=4.1"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@shadcn/react": "^0.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.21.0",
    "radix-ui": "^1.6.0",
    "react-day-picker": "^10.0.1",
    "react-resizable-panels": "^4.11.2",
    "recharts": "3.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@types/react": "19",
    "@types/react-dom": "19",
    "typescript": "^5.5.3"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
