# Environment for `docker compose up`. Copy to .env — every value here already
# has a working default, so nothing needs editing to boot on localhost.
#
#   cp .env.docker.example .env
#
# This is NOT .env.example: that one is for running the app from source against
# your own Neon database. docker compose brings its own Postgres.

# Port the app is published on. The app is then at http://localhost:<this>
APP_PORT=3142

# Password for the bundled postgres service. It is not published to the host,
# so the default is fine for a laptop; change it if the host is shared.
#   openssl rand -hex 16
POSTGRES_PASSWORD=agensis

# Signs session tokens. LEAVE EMPTY and the server generates one on first boot
# and stores it in the database, which is what you want for a single instance.
# Set it explicitly to run more than one app container against one database, or
# to rotate it (which signs every logged-in user out).
#   openssl rand -hex 32
AGENSIS_AUTH_SECRET=

# Optional. Enables AI chat. Can also be set later in the running app, under
# Settings → Secret keys, so it does not have to live in this file.
ANTHROPIC_API_KEY=

# Optional. The public origin, used to build invite and join links. Defaults to
# the request's own host, which is right for localhost.
#   AGENSIS_APP_URL=https://agensis.example.com

# Optional, and only needed when you serve the app over HTTPS on a hostname
# that is not localhost. On such an origin the frontend will not open its
# realtime websocket unless it is told the backend URL outright; set this to
# the same public origin to turn realtime back on. It is baked into the
# frontend bundle, so run `docker compose build` after changing it.
#   VITE_BACKEND_BASE_URL=https://agensis.example.com
VITE_BACKEND_BASE_URL=
