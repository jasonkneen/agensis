{
  "name": "visual-dev-editor",
  "version": "0.1.0",
  "description": "Dev-time visual editor for static sites: click-to-edit the live page, changes written back to the HTML source files on disk.",
  "license": "MIT",
  "main": "src/server.cjs",
  "bin": {
    "visual-dev-editor": "bin/cli.cjs"
  },
  "scripts": {
    "test": "node --test test/*.test.cjs",
    "demo": "node bin/cli.cjs examples --port 4399"
  },
  "dependencies": {
    "parse5": "^6.0.1"
  },
  "engines": {
    "node": ">=16"
  },
  "optionalDependencies": {
    "@babel/parser": "^7.24.0"
  },
  "exports": {
    ".": "./src/server.cjs",
    "./stamp": "./src/stamp.cjs",
    "./discover": "./src/discover.cjs"
  },
  "files": [
    "src",
    "bin",
    "README.md"
  ]
}
