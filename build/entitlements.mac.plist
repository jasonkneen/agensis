<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Standard Electron hardened-runtime entitlements, so a signed build can
	     still run its (unsigned) V8 JIT and native Node addons. -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
	<key>com.apple.security.cs.allow-dyld-environment-variables</key>
	<true/>
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>

	<!-- What macOS actually gates on a TCC prompt. Without this the OS has
	     nothing to remember a grant AGAINST, so every huddle re-asks. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.security.device.camera</key>
	<true/>

	<!-- The thin shell talks to the hosted backend over the network. -->
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
