# ============================================================================
# RESOLUTION (stage O) — Q1 answered by reading: the ONLY mock.module hook
# (tests/netlify-parity.test.cjs:44) targets '@netlify/database', NOT the core.
# All three test files import the core by plain dynamic-import specifier
# (netlify-parity:65, backend-rbac:27, activity-idempotency:23). So NO mock
# retargeting is needed post-rename — only the three specifier strings change,
# and `import()` of a .cjs yields named exports via cjs-module-lexer. Grounded:
# server keeps its OWN divergent security FUNCTIONS (enforceDbOperationAccess
# server/index.cjs:566 takes (userId,table,action,payload) + closes over module
# `db`; core's takes ({...,db})). Deduping those is a Large signature rewrite and
# is OUT OF SCOPE — the point-fixes P1/P2/P4/P5 already patch the function-level
# drift. The safe, mechanical, high-value dedup is the DATA that actually drifted
# (ALLOWED_TABLES 23 vs 19 vs 18; JSON_COLUMNS agent_connections.capabilities;
# VERSIONED_TABLES agent_memory_files/memory_file_comments): move the superset
# (server is the reference) into the core and destructure it in both runtimes —
# call-site names are unchanged, so it is a delete-local + require/import swap.
# The keystone is F4c: core .mjs -> .cjs so server can require() it SYNCHRONOUSLY
# (F4b: electron/main.cjs:3 + npm test consume server exports synchronously; no
# top-level await), while netlify keeps ESM named-import interop (F4d).
# ============================================================================
PLAN P11b<-F4c op=move at=shared/backend-core.mjs->shared/backend-core.cjs#"import crypto from 'node:crypto';" why=core-esm-to-cjs-single-static-module ref=shared/backend-core.mjs:18,shared/backend-core.mjs:25,netlify/functions/backend.mjs:7-16,electron/main.cjs:3,tests/backend-rbac.test.cjs:27 test="node -e \"const c=require('./shared/backend-core.cjs'); for(const k of ['verifyAuthToken','enforceDbOperationAccess','assertWorkspaceRole','ALLOWED_TABLES']) if(!(k in c)) throw new Error('missing '+k)\"" order=3 fill=S
# F4c: git mv shared/backend-core.mjs -> shared/backend-core.cjs, mechanical ESM->CJS:
#  - `import crypto from 'node:crypto'` -> `const crypto = require('node:crypto')`.
#  - strip `export` from every top-level const / function / async function.
#  - append ONE static literal `module.exports = { <every previously-exported name> }`:
#    verifyAuthToken, enforceDbOperationAccess, assertWorkspaceRole, ALLOWED_TABLES,
#    WORKSPACE_SCOPED_TABLES, WORKSPACE_ROLE_CAPABILITIES, DB_TABLE_ACCESS,
#    createTokenVersionCache, appendWorkspaceAccessClause, logMessageActivityIdempotent,
#    createRateLimiter, evaluatePasswordServerSide, findFilterValue,
#    resolveOperationWorkspace, userCanAccessWorkspace, getWorkspaceRole,
#    roleHasWorkspaceCapability, assertUpdateKeepsTenancy, httpError, unauthorized,
#    forbidden, badRequest, PASSWORD_MIN_LENGTH, PASSWORD_MIN_CLASSES — PLUS the two
#    added by P11c (VERSIONED_TABLES, JSON_COLUMNS_BY_TABLE). A single literal object
#    is what keeps ESM named-import interop working (F4d/cjs-module-lexer).
#  - No behavior change; node:crypto stays the sole dependency (F4c).
PLAN P11c<-F4 op=replace at=shared/backend-core.cjs:25-45#"const ALLOWED_TABLES = new Set([" why=widen-core-to-server-superset ref=server/index.cjs:21-45,server/index.cjs:47-62,server/index.cjs:64-72,netlify/functions/backend.mjs:69-112 test="node -e \"const c=require('./shared/backend-core.cjs'); if(!c.ALLOWED_TABLES.has('thread_items')||!c.JSON_COLUMNS_BY_TABLE.agent_connections.has('capabilities')||!c.VERSIONED_TABLES.has('agent_memory_files')) process.exit(1)\"" order=4 fill=-
<<<P11c
const ALLOWED_TABLES = new Set([
  'app_users',
  'workspaces',
  'documents',
  'chat_sessions',
  'messages',
  'memory_facts',
  'uploaded_files',
  'workspace_members',
  'canvas_groups',
  'canvas_objects',
  'tasks',
  'document_comments',
  'task_comments',
  'document_versions',
  'workspace_agents',
  'agent_webhooks',
  'agent_connections',
  'agent_jobs',
  'agent_registrations',
  'activity_events',
  'agent_memory_files',
  'memory_file_comments',
  'thread_items',
]);

// F4: superset lifted VERBATIM from server/index.cjs (the reference). Both runtimes
// destructure these from here so a table/column can never be exposed on one backend
// but not the other again (netlify was 18 tables, missing agent_connections.capabilities
// -> capability writes not cast ::jsonb). Also add VERSIONED_TABLES + JSON_COLUMNS_BY_TABLE
// to module.exports (P11b) so both are importable/requireable.
const VERSIONED_TABLES = new Set([
  'workspaces',
  'documents',
  'chat_sessions',
  'memory_facts',
  'uploaded_files',
  'canvas_groups',
  'canvas_objects',
  'tasks',
  'document_comments',
  'task_comments',
  'workspace_agents',
  'agent_webhooks',
  'agent_memory_files',
  'memory_file_comments',
]);

const JSON_COLUMNS_BY_TABLE = {
  chat_sessions: new Set(['participants']),
  canvas_objects: new Set(['points']),
  workspace_agents: new Set(['tools', 'skills']),
  agent_connections: new Set(['metadata', 'capabilities']),
  agent_jobs: new Set(['metadata']),
  activity_events: new Set(['metadata']),
  messages: new Set(['reactions']),
};
