HUMAN: Phased marketplace plan: schema, server-side config boundary, sandbox isolation, cross-workspace install, UI. Owner config never leaves server.
PLAN P1<-F1 op=insert at=server/index.cjs:794#"  await db.unsafe(`" why=phase1-schema-listings ref=database/neon-schema.sql:305,shared/backend-core.mjs:24,netlify/functions/backend.mjs:1 test="npm run build && node -e \"require('./server/index.cjs')\"" order=1 fill=-
<<<P1
  // --- Marketplace: global listing identity + immutable version snapshots + installs.
  // MIRROR this block VERBATIM into database/neon-schema.sql (canonical) so a fresh
  // db matches; runtime block here is what actually applies on fly.dev (F10).
  await db.unsafe(`
    CREATE TABLE IF NOT EXISTS marketplace_listings (
      id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
      owner_workspace_id uuid NOT NULL REFERENCES workspaces(id) ON DELETE CASCADE,
      owner_agent_id uuid REFERENCES workspace_agents(id) ON DELETE SET NULL,
      slug text NOT NULL UNIQUE,
      title text NOT NULL DEFAULT '',
      tagline text DEFAULT '',
      description text DEFAULT '',
      -- F8: media reuses uploaded_files storage; ids only, never inline blobs.
      avatar_file_id uuid REFERENCES uploaded_files(id) ON DELETE SET NULL,
      banner_file_id uuid REFERENCES uploaded_files(id) ON DELETE SET NULL,
      current_version_id uuid, -- FK added after versions table (cycle break)
      status text NOT NULL DEFAULT 'draft' CHECK (status IN ('draft','published','unlisted','delisted')),
      -- F4 pricing: platform-set fee in basis points; amount in minor units.
      price_model text NOT NULL DEFAULT 'free' CHECK (price_model IN ('free','per_task','per_request','per_hour')),
      price_amount_cents integer NOT NULL DEFAULT 0,
      currency text NOT NULL DEFAULT 'usd',
      platform_fee_bps integer NOT NULL DEFAULT 0,
      stripe_product_id text DEFAULT '',
      stripe_price_id text DEFAULT '',
      -- F5 runtime policy the install inherits (see P4 column defs on workspace_agents).
      runtime_kind text NOT NULL DEFAULT 'builtin' CHECK (runtime_kind IN ('builtin','sandbox','daemon_renter')),
      sandbox_backend text DEFAULT '' CHECK (sandbox_backend IN ('','local_sb','e2b')),
      runtime_config jsonb NOT NULL DEFAULT '{}'::jsonb,
      install_count integer NOT NULL DEFAULT 0,
      created_by uuid,
      version integer NOT NULL DEFAULT 1,
      created_at timestamptz DEFAULT now(),
      updated_at timestamptz DEFAULT now()
    );
    CREATE INDEX IF NOT EXISTS idx_marketplace_listings_owner_ws ON marketplace_listings(owner_workspace_id);
    CREATE INDEX IF NOT EXISTS idx_marketplace_listings_status ON marketplace_listings(status);

    -- F11: immutable snapshot of owner config at publish time. This is the ONLY
    -- place a published listing's system_prompt/soul lives. NEVER db-selectable,
    -- NEVER public (see P7/P8). No updated_at: rows are append-only.
    CREATE TABLE IF NOT EXISTS marketplace_listing_versions (
      id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
      listing_id uuid NOT NULL REFERENCES marketplace_listings(id) ON DELETE CASCADE,
      version_number integer NOT NULL,
      name text NOT NULL DEFAULT '',
      description text DEFAULT '',
      system_prompt text NOT NULL DEFAULT '',
      soul text DEFAULT '',
      instructions text DEFAULT '',
      tools jsonb NOT NULL DEFAULT '[]'::jsonb,
      skills jsonb NOT NULL DEFAULT '[]'::jsonb,
      model text NOT NULL DEFAULT 'auto',
      permission_mode text NOT NULL DEFAULT 'default',
      runtime_kind text NOT NULL DEFAULT 'builtin',
      sandbox_backend text DEFAULT '',
      runtime_config jsonb NOT NULL DEFAULT '{}'::jsonb,
      created_by uuid,
      created_at timestamptz DEFAULT now(),
      UNIQUE (listing_id, version_number)
    );
    CREATE INDEX IF NOT EXISTS idx_listing_versions_listing ON marketplace_listing_versions(listing_id);
    ALTER TABLE marketplace_listings DROP CONSTRAINT IF EXISTS fk_listings_current_version;
    ALTER TABLE marketplace_listings ADD CONSTRAINT fk_listings_current_version
      FOREIGN KEY (current_version_id) REFERENCES marketplace_listing_versions(id) ON DELETE SET NULL;

    -- F1/F6: an install materializes a thin workspace_agents row in the renter
    -- workspace pinned to one immutable version. instance_agent_id carries NO owner
    -- config (P6 resolves it server-side from listing_version_id).
    CREATE TABLE IF NOT EXISTS agent_installs (
      id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
      listing_id uuid NOT NULL REFERENCES marketplace_listings(id) ON DELETE CASCADE,
      listing_version_id uuid NOT NULL REFERENCES marketplace_listing_versions(id) ON DELETE RESTRICT,
      renter_workspace_id uuid NOT NULL REFERENCES workspaces(id) ON DELETE CASCADE,
      instance_agent_id uuid REFERENCES workspace_agents(id) ON DELETE CASCADE,
      status text NOT NULL DEFAULT 'active' CHECK (status IN ('active','paused','uninstalled')),
      stripe_subscription_id text DEFAULT '',
      installed_by uuid,
      version integer NOT NULL DEFAULT 1,
      created_at timestamptz DEFAULT now(),
      updated_at timestamptz DEFAULT now(),
      UNIQUE (listing_id, renter_workspace_id)
    );
    CREATE INDEX IF NOT EXISTS idx_agent_installs_renter_ws ON agent_installs(renter_workspace_id);
    CREATE INDEX IF NOT EXISTS idx_agent_installs_listing ON agent_installs(listing_id);
    CREATE INDEX IF NOT EXISTS idx_agent_installs_instance ON agent_installs(instance_agent_id);
  `);
>>>
PLAN P2<-F4 op=insert at=server/index.cjs:794#"  await db.unsafe(`" why=phase1-schema-usage-ledger ref=database/neon-schema.sql:305,server/index.cjs:2334#"  if (runMode === 'builtin') {" test="npm run build" order=1 fill=-
<<<P2
  // --- Marketplace billing ledger (F4). One row per metered unit; per_hour meters
  // wall-clock from agent_jobs.started_at/finished_at (OPEN Q1 assumption). MIRROR to
  // database/neon-schema.sql. Served via dedicated routes only (excluded from db/* — P8).
  await db.unsafe(`
    CREATE TABLE IF NOT EXISTS usage_ledger (
      id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
      install_id uuid NOT NULL REFERENCES agent_installs(id) ON DELETE CASCADE,
      listing_id uuid NOT NULL REFERENCES marketplace_listings(id) ON DELETE CASCADE,
      renter_workspace_id uuid NOT NULL REFERENCES workspaces(id) ON DELETE CASCADE,
      owner_workspace_id uuid NOT NULL REFERENCES workspaces(id) ON DELETE CASCADE,
      job_id uuid REFERENCES agent_jobs(id) ON DELETE SET NULL,
      meter text NOT NULL CHECK (meter IN ('task','request','seconds')),
      quantity numeric NOT NULL DEFAULT 0,
      amount_cents integer NOT NULL DEFAULT 0,
      platform_fee_cents integer NOT NULL DEFAULT 0,
      currency text NOT NULL DEFAULT 'usd',
      status text NOT NULL DEFAULT 'pending' CHECK (status IN ('pending','reported','invoiced','settled','void')),
      created_at timestamptz DEFAULT now()
    );
    CREATE INDEX IF NOT EXISTS idx_usage_ledger_install ON usage_ledger(install_id);
    CREATE INDEX IF NOT EXISTS idx_usage_ledger_owner_ws ON usage_ledger(owner_workspace_id, status);
  `);
>>>
PLAN P3<-F5 op=insert at=server/index.cjs:844#"    ALTER TABLE workspace_agents ADD COLUMN IF NOT EXISTS mcp_approved boolean" why=phase1-schema-instance-columns ref=database/neon-schema.sql:298#"  run_mode text NOT NULL DEFAULT 'builtin'," test="npm run build" order=1 fill=-
<<<P3
    -- F5/F6: marketplace install linkage + explicit runtime descriptor. Presence of
    -- source_listing_version_id marks a thin install instance whose owner config is
    -- resolved server-side (P6) and withheld from every renter-readable surface (P5).
    ALTER TABLE workspace_agents ADD COLUMN IF NOT EXISTS install_id uuid REFERENCES agent_installs(id) ON DELETE CASCADE;
    ALTER TABLE workspace_agents ADD COLUMN IF NOT EXISTS source_listing_id uuid REFERENCES marketplace_listings(id) ON DELETE SET NULL;
    ALTER TABLE workspace_agents ADD COLUMN IF NOT EXISTS source_listing_version_id uuid REFERENCES marketplace_listing_versions(id) ON DELETE SET NULL;
    ALTER TABLE workspace_agents ADD COLUMN IF NOT EXISTS runtime_kind text NOT NULL DEFAULT 'builtin';
    ALTER TABLE workspace_agents ADD COLUMN IF NOT EXISTS sandbox_backend text DEFAULT '';
    ALTER TABLE workspace_agents ADD COLUMN IF NOT EXISTS runtime_config jsonb NOT NULL DEFAULT '{}'::jsonb;
    CREATE INDEX IF NOT EXISTS idx_workspace_agents_install ON workspace_agents(install_id);
>>>
PLAN P4<-F2 op=replace at=server/index.cjs:1675-1699#"function agentRuntimePayload(agent) {" why=phase2-withhold-owner-config ref=server/index.cjs:1724#"      sendWs(entry.ws, { type: 'agent_config', agent });",agent/agensis-cli/src/agensis.mjs:237-240 test="grep -n 'isInstall ?' server/index.cjs && npm run build" order=2 fill=-
<<<P4
function agentRuntimePayload(agent) {
  if (!agent) return null;
  const permissionMode = normalizeAgentPermissionMode(agent.permission_mode || agent.permissionMode);
  // SECURITY (F2/F7): a marketplace install instance is a thin reference. Its owner
  // config (system_prompt/soul/instructions) lives ONLY in the pinned listing version
  // and is composed server-side (see runAgentTurn/P6). It must NEVER ride the WS
  // agent_config payload to a renter's daemon host. Installs also never run on the
  // renter's local daemon: force builtin so execution stays server/sandbox-side.
  const isInstall = Boolean(agent.source_listing_version_id || agent.install_id);
  return {
    id: agent.id,
    workspace_id: agent.workspace_id,
    name: agent.name,
    avatar: agent.avatar || 'AI',
    openpet_avatar_id: agent.openpet_avatar_id || '',
    handle: agent.handle || slugHandle(agent.name),
    description: agent.description || '',
    system_prompt: isInstall ? '' : (agent.system_prompt || ''),
    soul: isInstall ? '' : (agent.soul || ''),
    instructions: isInstall ? '' : (agent.instructions || ''),
    tools: parseJsonArray(agent.tools),
    skills: parseJsonArray(agent.skills),
    model: resolveAnthropicModel(agent.model),
    run_mode: isInstall ? 'builtin' : (agent.run_mode === 'daemon' ? 'daemon' : 'builtin'),
    permissionMode,
    permission_mode: permissionMode,
    permissionFlags: agentPermissionFlags(permissionMode),
    is_marketplace_install: isInstall,
    version: Number(agent.version || 0),
    enabled: isAgentEnabled(agent),
  };
}
>>>
