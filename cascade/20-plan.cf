PLAN P5a<-F5 op=insert at=server/index.cjs:2706#"end of handleAgentMemorySync" why=new-handler ref=server/index.cjs:2659-2706 test="npx tsc --noEmit" order=4
<<<P5a
async function handleAgentCapabilitiesSync(ws, message) {
  const auth = ws.agentAuth;
  if (!auth) throw forbidden('Agent token is required');
  const workspaceId = ws.workspaceId || auth.workspaceId;
  const agentId = ws.agentId || auth.agentId;
  const connectionId = ws.agentConnectionId;
  if (!workspaceId || !agentId || !connectionId) throw forbidden('Agent is not registered');
  const caps = message.capabilities && typeof message.capabilities === 'object' ? message.capabilities : {};
  const normalized = {
    skills: Array.isArray(caps.skills) ? caps.skills.map(String).slice(0, 200) : [],
    clis: Array.isArray(caps.clis) ? caps.clis.map(String).slice(0, 100) : [],
    mcpServers: Array.isArray(caps.mcpServers) ? caps.mcpServers.map(String).slice(0, 100) : [],
    ...(caps.memoryRoot ? { memoryRoot: String(caps.memoryRoot).slice(0, 1024) } : {}),
  };
  const rows = await getDb().unsafe(
    'update agent_connections set capabilities = $2, updated_at = now() where id = $1 returning *',
    [connectionId, JSON.stringify(normalized)],
  );
  if (rows[0]) notifyDbSubscribers('agent_connections', 'UPDATE', rows.map(publicAgentConnection));
}
>>>

