{
  "name": "agensis",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "version": "0.1.4",
  "description": "Realtime collaborative workspace for chat, documents, memory, files, and shared canvas.",
  "author": {
    "name": "Jason Kneen",
    "email": "hello@agensis.io"
  },
  "homepage": "https://agensis.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/jasonkneen/agensis.git"
  },
  "license": "AGPL-3.0-only",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "bin": {
    "agensis-ops": "cli/agensis-ops.mjs"
  },
  "scripts": {
    "ops": "node cli/agensis-ops.mjs",
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.app.json && vite build && node scripts/finalize-static-routing.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "node --require ./tests/helpers/test-env.cjs --experimental-test-module-mocks --test tests/*.test.cjs",
    "test:unit": "vitest run",
    "smoke": "vitest run --config vitest.smoke.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p packages/ui/tsconfig.json",
    "ci": "npm run typecheck && npm test && npm run voice:install && npm run test:voice && npm run test:unit && npm run smoke && npm run lint",
    "hooks:install": "git config core.hooksPath .githooks",
    "icon": "node scripts/generate-icon.cjs",
    "backend": "node --env-file=.env server/index.cjs",
    "migrate": "node --env-file=.env scripts/migrate.mjs",
    "dev:full": "node scripts/dev-full.mjs",
    "db:neon:push": "bash scripts/neon-push.sh",
    "reset:test-account": "node --env-file=.env scripts/reset-test-account.cjs",
    "desktop:dev": "node scripts/desktop-dev.mjs --local",
    "desktop:dev:local": "node scripts/desktop-dev.mjs --local",
    "desktop:dev:prod": "node scripts/desktop-dev.mjs --prod",
    "desktop:dev:live": "node scripts/desktop-dev.mjs --prod",
    "desktop:build": "node scripts/desktop-build.mjs --prod",
    "desktop:build:local": "node scripts/desktop-build.mjs --local",
    "desktop:build:prod": "node scripts/desktop-build.mjs --prod",
    "desktop:dist": "node scripts/desktop-build.mjs --prod --publish never",
    "desktop:dist:local": "node scripts/desktop-build.mjs --local --publish never",
    "desktop:dist:prod": "node scripts/desktop-build.mjs --prod --publish never",
    "desktop:verify-sign": "node scripts/desktop-verify-sign.mjs",
    "desktop:ship": "scripts/ship-signed.sh",
    "desktop:setup-signing-secrets": "scripts/setup-signing-secrets.sh",
    "electron:dev": "node scripts/desktop-dev.mjs --local",
    "electron:build": "node scripts/desktop-build.mjs --prod",
    "electron:dist": "node scripts/desktop-build.mjs --prod --publish never",
    "voice:install": "npm ci --prefix voice-worker --no-audit --no-fund",
    "test:voice": "npm test --prefix voice-worker",
    "ui:build": "npm run build -w @agensis/ui"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/archivo-black": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@livekit/components-react": "^2.9.24",
    "@mercuryworkshop/bare-mux": "^2.1.9",
    "@mercuryworkshop/scramjet": "1.1.0",
    "@netlify/blobs": "^11.1.3",
    "@netlify/database": "^2.0.1",
    "@netlify/identity": "^2.0.0",
    "@shadcn/react": "^0.3.1",
    "@streamdown/code": "^2.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "blobatar": "^2.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.16",
    "embla-carousel-react": "^8.6.0",
    "express": "^5.2.1",
    "fflate": "^0.8.3",
    "input-otp": "^1.5.0",
    "livekit-client": "^2.22.3",
    "livekit-server-sdk": "^2.19.1",
    "lucide-react": "^1.52.0",
    "mermaid": "^12.1.0",
    "next-themes": "^0.4.6",
    "nostr-tools": "2.25.2",
    "postgres": "^3.4.9",
    "radix-ui": "^1.7.0",
    "react": "19",
    "react-day-picker": "^10.0.2",
    "react-dom": "19",
    "react-resizable-panels": "^4.14.2",
    "recharts": "3.10.1",
    "sonner": "^2.0.8",
    "streamdown": "^2.7.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "undici": "^8.11.2",
    "vaul": "^1.1.2",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@agensis/ui": "*",
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "19",
    "@types/react-dom": "19",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.6.1",
    "electron": "^44.6.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "nitro": "3.0.260903-beta",
    "postcss": "^8.5.29",
    "shadcn": "^4.21.3",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  },
  "build": {
    "appId": "io.agensis.app",
    "productName": "agensis",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "npmRebuild": false,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "fileAssociations": [
      {
        "ext": "agn",
        "name": "Agensis Agent Bundle",
        "description": "Compressed agensis agent bundle",
        "role": "Editor",
        "mimeType": "application/vnd.agensis.agent-bundle"
      }
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "shared/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "electron/entitlements.mac.plist",
      "entitlementsInherit": "electron/entitlements.mac.plist",
      "identity": "Jason Kneen (SW75ZJJ5R6)",
      "notarize": true,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "agensis uses your microphone for voice huddles.",
        "NSCameraUsageDescription": "agensis uses your camera for video in huddles."
      },
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "writeUpdateInfo": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-${version}-${os}-${arch}-setup.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-${os}-${arch}-portable.${ext}"
    },
    "linux": {
      "category": "Office",
      "maintainer": "agensis <hello@agensis.io>",
      "executableName": "agensis",
      "synopsis": "Shared workspace for humans and AI agents",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "publish": {
      "provider": "github",
      "releaseType": "release"
    }
  },
  "optionalDependencies": {
    "node-pty": "^1.1.0"
  },
  "overrides": {
    "body-parser": "2.3.0",
    "fast-uri": "4.1.1",
    "qs": "6.15.3"
  }
}
