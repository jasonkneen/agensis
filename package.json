{
  "name": "agensis",
  "private": true,
  "version": "0.1.0",
  "description": "Realtime collaborative workspace for chat, documents, memory, files, and shared canvas.",
  "homepage": "https://agensis.io",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "node --experimental-test-module-mocks --test tests/*.test.cjs",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "ci": "npm run typecheck && npm test && npm run test:unit && npm run lint",
    "hooks:install": "git config core.hooksPath .githooks",
    "icon": "node scripts/generate-icon.cjs",
    "backend": "node --env-file=.env server/index.cjs",
    "migrate": "node --env-file=.env scripts/migrate.mjs",
    "dev:full": "node scripts/dev-full.mjs",
    "db:neon:push": "bash scripts/neon-push.sh",
    "reset:test-account": "node --env-file=.env scripts/reset-test-account.cjs",
    "desktop:dev": "node scripts/desktop-dev.mjs",
    "desktop:build": "node scripts/desktop-build.mjs",
    "desktop:dist": "node scripts/desktop-build.mjs",
    "electron:dev": "node scripts/desktop-dev.mjs",
    "electron:build": "node scripts/desktop-build.mjs",
    "electron:dist": "node scripts/desktop-build.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource/archivo-black": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/press-start-2p": "^5.2.7",
    "@fontsource/space-grotesk": "^5.2.10",
    "@fontsource/space-mono": "^5.2.9",
    "@netlify/database": "^1.1.0",
    "@netlify/identity": "^1.2.0",
    "@shadcn/react": "^0.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.11",
    "embla-carousel-react": "^8.6.0",
    "express": "^5.2.1",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.21.0",
    "mermaid": "^11.16.0",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "radix-ui": "^1.6.0",
    "react": "19",
    "react-day-picker": "^10.0.1",
    "react-dom": "19",
    "react-resizable-panels": "^4.11.2",
    "recharts": "3.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "vite-plugin-pwa": "^1.2.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^26.0.1",
    "@types/react": "19",
    "@types/react-dom": "19",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.35",
    "shadcn": "^4.12.0",
    "sharp": "^0.33.5",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2",
    "vitest": "^4.1.9"
  }
}
