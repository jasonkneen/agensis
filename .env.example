DATABASE_URL=postgresql://user:password@host/db?sslmode=require
NEON_API_KEY=your_neon_admin_key
ANTHROPIC_API_KEY=your_anthropic_api_key

# Optional. Point the local web app at a remote backend (e.g. production fly)
# instead of the local one. When unset, localhost uses the vite proxy to
# 127.0.0.1:3142. Example: https://agensis-backend.fly.dev
VITE_BACKEND_BASE_URL=
